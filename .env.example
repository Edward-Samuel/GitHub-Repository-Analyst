# GitHub Repository Analyst - Environment Configuration Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

# Gemini API Key (required for AI analysis features)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# GitHub Token (optional, increases rate limit from 60 to 5000 req/hour)
# Get your token at: https://github.com/settings/tokens
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE

# Model selection: primary model is preferred first, fallback is used when the primary is unavailable
PRIMARY_MODEL=gemma-4-26b-a4b-it
FALLBACK_MODEL=gemma-4-31b-it

# Analysis Settings
DEFAULT_DEPTH=medium
DEFAULT_REPORT_FORMAT=markdown
MAX_FILE_SIZE_KB=100
MAX_FILES_TO_ANALYZE=200
CACHE_RESPONSES=true
CACHE_DIR=.cache
